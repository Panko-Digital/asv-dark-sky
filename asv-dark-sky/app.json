{
  "name": "asv-dark-sky",
  "slug": "asv-dark-sky",
  "expo": {
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "recordAudioAndroid": false,
          "saveToCameraRoll": false,
          "locationPermission": "Allow $(PRODUCT_NAME) to access your location",
          "imagePickerPermission": "Allow $(PRODUCT_NAME) to access your photos"
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME) needs camera access to capture sky photos for light pollution measurements.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to tag sky quality measurements with geographic coordinates.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location to tag sky quality measurements with geographic coordinates.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to tag sky quality measurements with geographic coordinates."
        }
      ],
      [
        "expo-font"
      ],
      "./plugins/withAndroidSdkVersions.js",
      "./plugins/withMapboxConfig.js"
    ],
    "extra": {
      "eas": {
        "projectId": "09e19a64-809a-4289-b691-fd5c9d771acb"
      }
    },
    "ios": {
      "bundleIdentifier": "com.stesmi99.asvdarksky",
      "deploymentTarget": "15.1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to tag sky quality measurements with geographic coordinates."
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/09e19a64-809a-4289-b691-fd5c9d771acb"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.stesmi99.asvdarksky",
      "minSdkVersion": 24,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "buildToolsVersion": "35.0.0"
    }
  },
  "extra": {
    "eas": {
      "projectId": "09e19a64-809a-4289-b691-fd5c9d771acb"
    }
  },
  "owner": "stesmi99"
}
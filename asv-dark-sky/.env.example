# Example environment variables
# Copy this file to .env and add your actual API keys

# Mapbox Public API Key (safe for client-side use)
# Get from: https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_API_KEY=pk.your_public_token_here

# Mapbox Downloads Token (for Android builds)
# Get from: https://account.mapbox.com/access-tokens/
# This is also configured in EAS secrets
MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_token_here
